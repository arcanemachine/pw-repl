{
  "name": "pw-repl",
  "version": "0.17.2",
  "description": "Text REPL for driving an existing Chromium through Playwright over CDP",
  "keywords": [
    "playwright",
    "repl",
    "cdp",
    "chromium",
    "browser",
    "devtools",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanemachine/pw-repl.git"
  },
  "bin": {
    "pw-repl": "bin/pw-repl.js"
  },
  "files": [
    "bin/",
    "lib/",
    "AGENTS.md",
    "skill/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "start": "node bin/pw-repl.js run",
    "test": "node --test 'test/*.test.js'",
    "typecheck": "tsc",
    "preversion": "npm run typecheck && npm test",
    "release": "npm version -m \"chore: release %s\"",
    "deploy": "node scripts/check-tagged.js && git push --follow-tags && npm login && npm publish",
    "prepublishOnly": "node scripts/check-tagged.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
